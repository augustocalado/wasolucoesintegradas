# Configuração do Supabase - copie para .env.local e preencha
# Crie o projeto em https://supabase.com (Settings > API)

# URL do projeto (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) - pode ficar exposta no frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) - APENAS no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=
